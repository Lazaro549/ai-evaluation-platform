# ========================
# Anthropic Claude API
# ========================

# Your Anthropic API key (required)
# Get it from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default model to use across the project
# Options (as of 2026):
#   - claude-opus-4-6
#   - claude-sonnet-4-6   ← recommended default
#   - claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: override the base URL (useful for proxies or compatible providers)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
